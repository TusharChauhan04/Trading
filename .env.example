# The India Desk - configuration template.
#
# COPY THIS TO `.env` AND FILL IT IN.  `.env` is gitignored; this file is
# tracked and must never contain a real secret.
#
#     cp .env.example .env
#
# Anything already set in the real process environment WINS over this
# file - see desk/settings.py. The file is a laptop convenience, not the
# source of truth for a deployment.


# ---------------------------------------------------------------------
# Stage 3 - the ONLY part of the system that costs money
# ---------------------------------------------------------------------
# Without this key Stage 3 simply does not run: the shortlist passes
# through untouched and the daily plan says the narrative check was
# skipped. Everything else - Stages 0, 1, 2 and 4 - is unaffected.
#
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# A HARD stop, checked BEFORE every call against a running ledger of real
# spend. Not a budget - a blast radius. Expected real usage is one call
# per trading day at roughly Rs 0.05, so Rs 1-3 a month; this default is
# about 150x that. It exists because a bug that loops is the realistic
# way this costs money, not normal use.
DESK_LLM_MONTHLY_CEILING_INR=500

# gpt-4o-mini is the default and is plenty: Stage 3 reads a table Stages
# 0-2 already computed and returns a short structured verdict. gpt-4o is
# roughly 16x the cost for this workload.
DESK_LLM_MODEL=gpt-4o-mini

# ===========================================================================
# THREE ROUTES FOR STAGE 3. Pick ONE. Leave all of this commented to use the
# OPENAI_API_KEY above.
#
# `desk config` prints which route is live. In every case the call is still
# written to the spend ledger - at Rs 0 for the free routes - because "did
# Stage 3 run today" is a separate question from what it cost.
#
# NOT MEASURED FOR ANY OF THEM: whether a given model judges the shortlist as
# well as gpt-4o-mini. These remove the billing blocker; none establishes
# quality, and that comparison is still to be run.
# ===========================================================================

# --- ROUTE 2: a LOCAL model. Free, private, needs an install. ---------------
# Any server speaking OpenAI's /v1/chat/completions works:
#   LM Studio  http://localhost:1234/v1   (load a model, Developer tab -> Start)
#   Ollama     http://localhost:11434/v1
#   llama.cpp  http://localhost:8080/v1
#
# DESK_LLM_BASE_URL=http://localhost:1234/v1
#
# No key is needed and NONE IS SENT - so if this URL is ever mis-set to a paid
# endpoint the request fails with 401 instead of quietly billing an account.
# Nothing leaves your laptop. Set DESK_LLM_MODEL to whatever your server
# serves; most ignore the field and use the single loaded model.
# This route WINS over OPENAI_API_KEY even when a key is present, because a key
# left on disk is usually leftover rather than a preference.

# --- ROUTE 3: a hosted FREE tier. No install, no payment. -------------------
# OpenRouter proxies many models behind one OpenAI-compatible API, and the ones
# suffixed ":free" cost nothing. A key IS required but is free to create and
# needs no payment method. Found in OpenTerminalUI's services/llm/model_router.
#
# DESK_LLM_BASE_URL=https://openrouter.ai/api/v1
# DESK_LLM_API_KEY=sk-or-v1-...
# DESK_LLM_MODEL=openai/gpt-oss-20b:free
#
# Other free models in upstream's fallback chain:
#   deepseek/deepseek-r1:free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
#
# A base URL WITH a key means hosted; a base URL ALONE means local. The hosted
# provider REFUSES any model without a ":free" suffix, so a paid model cannot
# reach the meter through it and be priced at zero.
#
# WORSE THAN ROUTE 2 IN THREE WAYS, stated because "free" hides them:
#   - it is an external service, so "nothing leaves your laptop" is gone
#   - some free tiers train on submitted data by default
#   - rate limits are tight (tens of requests a day) and models get withdrawn
#     without notice, which is why upstream keeps an ordered fallback chain

# Rupees per US dollar, for converting OpenAI's USD billing to the rupee
# ceiling above. Deliberately a constant, not a live rate: a ceiling that
# moves on its own is not a ceiling.
DESK_USD_INR=90


# ---------------------------------------------------------------------
# Trading
# ---------------------------------------------------------------------
# Capital the risk engine sizes against, in rupees. The web app asks for
# this per request; this is the fallback for CLI runs and backtests.
DESK_DEFAULT_CAPITAL=100000

# Reward-to-risk. 2 means 1:2 - risk one rupee to make two. The target
# price is set this many multiples of the stop distance away.
#
# This was 2.5 until a backtest measured what it cost: over 60 trades
# only 3 ever reached a 2.5R target while 23 took full stops, inside a
# 5-day horizon. A target the market rarely reaches is not a better
# trade, it is a trade that mostly times out.
DESK_RISK_REWARD=2

# FUNDAMENTAL FILTERS. Both OFF unless set - leave them blank to disable.
# These decide which companies the desk will trade at all, which is your
# policy call rather than a default worth choosing for you.
#
# Exclude a name whose newest filing is older than this many days.
# CHECK THE AGE DISTRIBUTION FIRST: `python -m desk.research.refresh
# fundamentals` prints min/median/max. Right now every filing on disk is
# 555-616 days old, because NSE's results endpoint returns nothing newer
# than Jan 2025 - so a plausible-looking 200 here would exclude the
# ENTIRE universe and return NO TRADE every day while appearing to work.
DESK_MAX_FILING_AGE_DAYS=

# Exclude a name whose net margin is below this percentage. 0 is the
# obvious first choice: it drops loss-making companies. A name with no
# filing on record is NOT excluded by this - it is reported as unchecked,
# which is a different thing from failing.
DESK_MIN_NET_MARGIN_PCT=


# ---------------------------------------------------------------------
# Paths (optional)
# ---------------------------------------------------------------------
# Where generated configs live. Defaults to ./configs next to the source.
# DESK_CONFIG_DIR=/var/lib/india-desk/configs

# Comma-separated origins allowed to call the API from a browser.
# DESK_CORS_ORIGINS=http://localhost:5173
